# 🧠 1. AI Models (Direct Keys)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 🔴 2. YouTube Shorts (Direct OAuth Keys)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 🔥 3. Firebase Cloud Database (Direct Keys)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# 📸 4. Instagram Reels (Direct Keys)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# 📘 5. Facebook Reels (Direct Keys)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# 🎵 6. TikTok (Direct Keys)
TIKTOK_ACCESS_TOKEN=

# ⚡ 7. Universal Social Webhook (Optional)
